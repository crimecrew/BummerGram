/* ===================================================================
   BummerGram - Dark Theme
   Version: 1.0.0
   =================================================================== */

/* -------------------------------------------------------------------
   Color Palette
   ------------------------------------------------------------------- */
   
BummerGram,
BummerGram QWidget {
    /* Primary Colors */
    q_property-primaryBackground: #1a1a2e;
    q_property-primaryForeground: #eaeaea;
    q_property-primaryAccent: #0f3460;
    q_property-primaryAccentHover: #1a5090;
    q_property-primaryAccentActive: #0a2540;
    
    /* Secondary Colors */
    q_property-secondaryBackground: #16213e;
    q_property-secondaryForeground: #b0b0b0;
    q_property-secondaryAccent: #533483;
    
    /* Semantic Colors */
    q_property-successColor: #2e7d32;
    q_property-warningColor: #f57c00;
    q_property-errorColor: #c62828;
    q_property-infoColor: #1976d2;
    
    /* Surface Colors */
    q_property-surfaceElevated: #1e2744;
    q_property-surfaceOverlay: rgba(0, 0, 0, 0.5);
    
    /* Border Colors */
    q_property-borderColor: #0f3460;
    q_property-borderColorLight: #2a4a7a;
    
    /* Selection */
    q_property-selectionBackground: #0f3460;
    q_property-selectionForeground: #ffffff;
}

/* -------------------------------------------------------------------
   Main Window
   ------------------------------------------------------------------- */

QMainWindow {
    background-color: #1a1a2e;
}

QWidget {
    background-color: #1a1a2e;
    color: #eaeaea;
    font-family: "Segoe UI", -apple-system, sans-serif;
    font-size: 9pt;
}

/* -------------------------------------------------------------------
   Text
   ------------------------------------------------------------------- */

QLabel {
    color: #eaeaea;
    background-color: transparent;
}

QLabel[heading="true"] {
    font-size: 14pt;
    font-weight: bold;
    color: #ffffff;
}

QLabel[subheading="true"] {
    font-size: 11pt;
    color: #b0b0b0;
}

/* -------------------------------------------------------------------
   Buttons
   ------------------------------------------------------------------- */

QPushButton {
    background-color: #0f3460;
    color: #eaeaea;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #1a5090;
}

QPushButton:pressed {
    background-color: #0a2540;
}

QPushButton:disabled {
    background-color: #2a2a3e;
    color: #666666;
}

QPushButton[primary="true"] {
    background-color: #2e7d32;
}

QPushButton[primary="true"]:hover {
    background-color: #388e3c;
}

QPushButton[primary="true"]:pressed {
    background-color: #1b5e20;
}

QPushButton[danger="true"] {
    background-color: #c62828;
}

QPushButton[danger="true"]:hover {
    background-color: #d32f2f;
}

/* -------------------------------------------------------------------
   Line Edit & Text Fields
   ------------------------------------------------------------------- */

QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #16213e;
    color: #eaeaea;
    border: 1px solid #0f3460;
    border-radius: 4px;
    padding: 8px;
    selection-background-color: #0f3460;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #1a5090;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: #2a2a3e;
    color: #666666;
}

/* -------------------------------------------------------------------
   Combo Box
   ------------------------------------------------------------------- */

QComboBox {
    background-color: #16213e;
    color: #eaeaea;
    border: 1px solid #0f3460;
    border-radius: 4px;
    padding: 8px 12px;
    min-width: 80px;
}

QComboBox:hover {
    border: 1px solid #1a5090;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #888;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #16213e;
    color: #eaeaea;
    border: 1px solid #0f3460;
    selection-background-color: #0f3460;
    outline: none;
}

/* -------------------------------------------------------------------
   List & Tree Widgets
   ------------------------------------------------------------------- */

QListWidget,
QTreeWidget,
QTableWidget {
    background-color: #16213e;
    color: #eaeaea;
    border: 1px solid #0f3460;
    border-radius: 4px;
    outline: none;
    selection-background-color: #0f3460;
}

QListWidget::item,
QTreeWidget::item,
QTableWidget::item {
    padding: 6px;
    border-radius: 2px;
}

QListWidget::item:selected,
QTreeWidget::item:selected,
QTableWidget::item:selected {
    background-color: #0f3460;
    color: #ffffff;
}

QListWidget::item:hover,
QTreeWidget::item:hover,
QTableWidget::item:hover {
    background-color: #1e2744;
}

/* -------------------------------------------------------------------
   Scroll Bars
   ------------------------------------------------------------------- */

QScrollBar:vertical {
    background-color: #1a1a2e;
    width: 12px;
    border-radius: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #0f3460;
    border-radius: 6px;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #1a5090;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
}

QScrollBar:horizontal {
    background-color: #1a1a2e;
    height: 12px;
    border-radius: 6px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #0f3460;
    border-radius: 6px;
    min-width: 30px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #1a5090;
}

/* -------------------------------------------------------------------
   Tab Widget
   ------------------------------------------------------------------- */

QTabWidget::pane {
    border: 1px solid #0f3460;
    background-color: #16213e;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #16213e;
    color: #888888;
    padding: 10px 20px;
    border: 1px solid #0f3460;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #0f3460;
    color: #eaeaea;
}

QTabBar::tab:hover:!selected {
    background-color: #1e2744;
}

/* -------------------------------------------------------------------
   Group Box
   ------------------------------------------------------------------- */

QGroupBox {
    font-weight: bold;
    color: #eaeaea;
    border: 1px solid #0f3460;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 6px;
}

/* -------------------------------------------------------------------
   Menu
   ------------------------------------------------------------------- */

QMenu {
    background-color: #16213e;
    color: #eaeaea;
    border: 1px solid #0f3460;
    border-radius: 4px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px 8px 12px;
    border-radius: 2px;
}

QMenu::item:selected {
    background-color: #0f3460;
}

QMenu::separator {
    height: 1px;
    background-color: #0f3460;
    margin: 4px 8px;
}

QMenuBar {
    background-color: #1a1a2e;
    color: #eaeaea;
}

QMenuBar::item {
    padding: 8px 12px;
    background-color: transparent;
}

QMenuBar::item:selected {
    background-color: #0f3460;
    border-radius: 2px;
}

/* -------------------------------------------------------------------
   Tool Tip
   ------------------------------------------------------------------- */

QToolTip {
    background-color: #0f3460;
    color: #eaeaea;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
}

/* -------------------------------------------------------------------
   Status Bar
   ------------------------------------------------------------------- */

QStatusBar {
    background-color: #16213e;
    color: #b0b0b0;
    border-top: 1px solid #0f3460;
}

QStatusBar::item {
    border: none;
}

/* -------------------------------------------------------------------
   Progress Bar
   ------------------------------------------------------------------- */

QProgressBar {
    background-color: #16213e;
    color: #eaeaea;
    border: none;
    border-radius: 4px;
    text-align: center;
    min-height: 16px;
}

QProgressBar::chunk {
    background-color: #0f3460;
    border-radius: 4px;
}

/* -------------------------------------------------------------------
   Check Box & Radio Button
   ------------------------------------------------------------------- */

QCheckBox,
QRadioButton {
    color: #eaeaea;
    spacing: 8px;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #0f3460;
    border-radius: 3px;
    background-color: #16213e;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: #1a5090;
}

QCheckBox::indicator:checked {
    background-color: #2e7d32;
    border-color: #2e7d32;
    image: none;
}

QCheckBox::indicator:checked:after {
    content: "✓";
    color: white;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QRadioButton::indicator:checked {
    background-color: #2e7d32;
    border-color: #2e7d32;
}

QRadioButton::indicator:checked:after {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: white;
}

/* -------------------------------------------------------------------
   Spin Box
   ------------------------------------------------------------------- */

QSpinBox,
QDoubleSpinBox {
    background-color: #16213e;
    color: #eaeaea;
    border: 1px solid #0f3460;
    border-radius: 4px;
    padding: 6px;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #1a5090;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button {
    background-color: #0f3460;
    border-radius: 2px;
    width: 20px;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #1a5090;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #888;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #888;
}

/* -------------------------------------------------------------------
   Slider
   ------------------------------------------------------------------- */

QSlider::groove:horizontal {
    background-color: #16213e;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #0f3460;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #1a5090;
}

QSlider::sub-page:horizontal {
    background-color: #2e7d32;
    border-radius: 3px;
}

/* -------------------------------------------------------------------
   Dialog
   ------------------------------------------------------------------- */

QDialog {
    background-color: #1a1a2e;
}

QDialogButtonBox {
    button-layout: 0; /* OS default */
}

/* -------------------------------------------------------------------
   Custom Classes
   ------------------------------------------------------------------- */

/* Chat bubble */
ChatBubble[outgoing="true"] {
    background-color: #0f3460;
    color: #ffffff;
    border-radius: 12px;
    padding: 8px 12px;
}

ChatBubble[outgoing="false"] {
    background-color: #16213e;
    color: #eaeaea;
    border-radius: 12px;
    padding: 8px 12px;
}

/* Avatar */
AvatarWidget {
    border-radius: 20px;
}

/* Media preview */
MediaPreview {
    border: 1px solid #0f3460;
    border-radius: 8px;
}
